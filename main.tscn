[sub_resource type="GDScript" id="GDScript_x4wxa"]
script/source = "@tool
extends Node3D

@export var cameraA: Camera3D
@export var cameraB: Camera3D
@export var viewRect: ColorRect
@export var quatRect: ColorRect
@export var fov: float = 90:
	set(val):
		fov = val
		updateCameraFOVs()

func updateCameraFOVs():
	cameraA.fov = fov
	cameraB.fov = fov

func triggerSideReset():
	(quatRect.material as ShaderMaterial).set_shader_parameter('clear', true);
	await get_tree().process_frame
	await get_tree().process_frame
	(quatRect.material as ShaderMaterial).set_shader_parameter('clear', false);

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	updateCameraFOVs()
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	cameraA.transform = global_transform
	cameraB.transform = global_transform
	var proj := cameraA.get_camera_projection()
	var vpext := proj.get_viewport_half_extents()
	var near := proj.get_z_near()
	(viewRect.material as ShaderMaterial).set_shader_parameter(&'camTransform',
			cameraA.basis * Basis.from_scale(Vector3(vpext.x, -vpext.y, -near)))
	(quatRect.material as ShaderMaterial).set_shader_parameter(&'cameraQuat',
			Quaternion() if Engine.is_editor_hint() else $\"..\".getLookQuat())
	pass
"

